# Fournisseur à utiliser : gemini ou anthropic
LLM_PROVIDER=gemini

# Gemini via l'API compatible OpenAI
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Exemple : gemini-3.8-flash (un modèle disponible sur ton compte)
GEMINI_MODEL=
# Modèles de repli facultatifs, utilisés uniquement pour le parsing des CV.
GEMINI_FALLBACK_MODELS=

# Anthropic (utilisé si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Exemple : claude-sonnet-5-5
ANTHROPIC_MODEL=
# Modèles de repli facultatifs, utilisés uniquement pour le parsing des CV.
ANTHROPIC_FALLBACK_MODELS=
ANTHROPIC_WORKSPACE_ID=

# Dossier local de persistance ChromaDB
CHROMA_DB_PATH=.chroma
